#!/usr/bin/env bash
# Launcher for the Synqit CLI.
#
# Jac's native-binary compiler (nacompile) doesn't support the subprocess and
# HTTP interop this CLI needs, so this execs `jac run` rather than being a
# compiled binary. Everything below exists so a broken setup produces one clear
# sentence instead of a Python traceback - or, worse, silence.
set -euo pipefail

die() {
  printf '  [x] %s\n' "$1" >&2
  shift
  for line in "$@"; do
    printf '      %s\n' "$line" >&2
  done
  exit 1
}

# Resolve this script through any number of symlinks so `ln -s` onto PATH works
# from anywhere. Deliberately not `readlink -f`: that is GNU-only and silently
# absent on macOS, where this is most likely to be run.
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
BIN_DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
REPO_ROOT="$(dirname "$BIN_DIR")"
ENTRY="$REPO_ROOT/cli/synqit.jac"

if ! command -v jac >/dev/null 2>&1; then
  die "\`jac\` is not installed or not on PATH." \
      "Synqit is written in Jac and runs through it:" \
      "  pip install jaclang byllm requests"
fi

if ! command -v git >/dev/null 2>&1; then
  die "\`git\` is not installed or not on PATH." \
      "Synqit drives git directly to read and publish your repository."
fi

# A moved or partially-cloned checkout is what this catches: the symlink on
# PATH still resolves, but the code it points at is gone.
if [ ! -f "$ENTRY" ]; then
  die "Synqit's CLI is missing at $ENTRY" \
      "This launcher resolved its install to:" \
      "  $REPO_ROOT" \
      "If that checkout moved or was deleted, re-link it:" \
      "  ln -sf /path/to/synqit/bin/synqit \"$BIN_DIR/synqit\""
fi

exec jac run "$ENTRY" "$@"
